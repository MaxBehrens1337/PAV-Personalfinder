# =============================================================================
# PAV Personalfinder - Environment Configuration
# =============================================================================
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an
# cp .env.example .env

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=pav_user
POSTGRES_PASSWORD=pav_password
POSTGRES_DB=pav_personalfinder
DATABASE_URL=postgresql://pav_user:pav_password@db:5432/pav_personalfinder

# =============================================================================
# Security & Authentication
# =============================================================================
# WICHTIG: Ändern Sie diese Werte in Produktion!
# Generieren Sie einen sicheren Key mit: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# AI/ML Configuration
# =============================================================================
# Qdrant Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=employee_profiles

# Ollama LLM
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# =============================================================================
# Application Configuration
# =============================================================================
# Frontend
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=PAV Personalfinder
VITE_APP_VERSION=1.0.0

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_AI_MATCHING=true
ENABLE_AUDIT_LOG=true
ENABLE_EMAIL_NOTIFICATIONS=false

# =============================================================================
# Performance & Limits
# =============================================================================
MAX_SEARCH_RESULTS=50
AI_MATCHING_TIMEOUT=10
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# DSGVO / Privacy
# =============================================================================
DATA_RETENTION_DAYS=2555  # ~7 Jahre
AUDIT_LOG_RETENTION_DAYS=3650  # 10 Jahre
